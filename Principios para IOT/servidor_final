import asyncio
import websockets
import json
import pandas as pd
import joblib

#Cargar el modelo de IA entrenada
print("Cargando modelo de IA...")
try:
    model = joblib.load("modelo_gestos.pkl")
except FileNotFoundError:
    print("ERROR No se encontro el archivo 'modelo_gestos.pkl'.")
    print("Ejecuta primero 'entrenar_ia.py'.")
    exit()

# Define las columnas en el orden exacto en que se entreno el modelo
columns = ['flex1', 'flex2', 'flex3', 'flex4', 'flex5',
           'ax', 'ay', 'az', 'gx', 'gy', 'gz']

print("Modelo cargado. Esperando conexión del guante...")

# Funcion que maneja la conexion del guante
async def handler(websocket):
    print("Guante conectado Empezando a predecir...")
    last_prediction = ""
    try:
        async for message in websocket:
            data = json.loads(message)
            
            # Prepara los datos recibidos en el formato correcto
            flat_data = data['flex'] + \
                        [data['accel']['x'], data['accel']['y'], data['accel']['z']] + \
                        [data['gyro']['x'], data['gyro']['y'], data['gyro']['z']]
            
            df = pd.DataFrame([flat_data], columns=columns)
            
            # Realiza la predicción con el modelo
            prediction = model.predict(df)[0]
            probability = model.predict_proba(df).max()
            
            # Imprime la prediccion solo si es nueva y la confianza es alta (70%)
            # Esto evita que la pantalla se llene de texto repetido.
            if prediction != last_prediction and probability > 0.70:
                 print(f"Predicción: {prediction} (Confianza: {probability*100:.1f}%)")
                 last_prediction = prediction
                    
    except websockets.exceptions.ConnectionClosed:
        print("\n🧤 Guante desconectado.")

# Funcion principal que inicia el servidor
async def main():
    # El "0.0.0.0" permite que el ESP32 se conecte desde la red local
    async with websockets.serve(handler, "0.0.0.0", 8765):
        await asyncio.Future() # Correr indefinidamente hasta que se cierre

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nServidor cerrado.")