import asyncio
import websockets
import json
import pandas as pd
import os

CSV_FILE = "datos_gestos.csv"
data_buffer = []
is_recording = False
current_label = ""

async def handler(websocket):
    global is_recording, current_label, data_buffer
    print("Guante conectado!")
    try:
        async for message in websocket:
            if is_recording:
                data = json.loads(message)
                flat_data = [current_label] + data['flex'] + \
                            [data['accel']['x'], data['accel']['y'], data['accel']['z']] + \
                            [data['gyro']['x'], data['gyro']['y'], data['gyro']['z']]
                data_buffer.append(flat_data)
                print(f"\rGrabando '{current_label}'... Muestras: {len(data_buffer)}", end="")
    except websockets.exceptions.ConnectionClosed:
        print("\nGuante desconectado.")
    finally:
        save_data()

def save_data():
    if not data_buffer: return
    print(f"\nGuardando {len(data_buffer)} muestras en {CSV_FILE}...")
    columns = ['label', 'flex1', 'flex2', 'flex3', 'flex4', 'flex5',
               'ax', 'ay', 'az', 'gx', 'gy', 'gz']
    new_df = pd.DataFrame(data_buffer, columns=columns)
    if os.path.exists(CSV_FILE):
        new_df.to_csv(CSV_FILE, mode='a', header=False, index=False)
    else:
        new_df.to_csv(CSV_FILE, index=False)
    print("Datos guardados.")
    data_buffer.clear()

async def control_loop():
    global is_recording, current_label
    print("--- Servidor de Captura de Datos ---")
    while True:
        command = await asyncio.to_thread(input, "Presiona una letra para GRABAR, [Enter] para PARAR, [exit] para SALIR: ")
        
        # Comando para salir del programa
        if command.lower() == 'exit':
            if is_recording: save_data()
            asyncio.get_running_loop().stop()
            break
        # Comando para empezar a grabar
        elif len(command) == 1 and command.isalpha():
            if is_recording: save_data()
            is_recording = True
            current_label = command.upper()
            print(f"--- Empezando a grabar para la letra '{current_label}' ---")
        # Comando para detener la grabación (solo presionar Enter)
        elif command == '':
            if is_recording:
                print("\n--- Grabación detenida. ---")
                is_recording = False
                save_data()

async def main():
    server = await websockets.serve(handler, "0.0.0.0", 8765)
    await control_loop()
    server.close()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (RuntimeError, KeyboardInterrupt):
        pass
    print("Servidor cerrado.")